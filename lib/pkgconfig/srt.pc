prefix=/home/runner/work/ffmpeg-build-script/ffmpeg-build-script/workspace
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: srt
Description: SRT library set
Version: 1.5.5
Libs: -L${libdir} -lsrt   
Libs.private:    -lm     -lc    
Cflags: -I${includedir} -I${includedir}/srt
Requires.private: openssl libcrypto
